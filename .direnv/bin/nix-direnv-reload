#!/usr/bin/env bash
set -e
if [[ ! -d "/home/dmnt/dev/fr/open-source/niri-taskbar" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/dmnt/dev/fr/open-source/niri-taskbar")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/dmnt/dev/fr/open-source/niri-taskbar" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/home/dmnt/dev/fr/open-source/niri-taskbar/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/home/dmnt/dev/fr/open-source/niri-taskbar/.envrc" "/home/dmnt/dev/fr/open-source/niri-taskbar/.direnv"/*.rc
